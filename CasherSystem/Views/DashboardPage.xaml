<UserControl x:Class="CasherSystem.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="materialDesign:Card">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="materialDesign:ShadowAssist.ShadowDepth" Value="Depth2"/>
        </Style>

        <Style x:Key="DashboardTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DashboardLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Header -->
            <TextBlock Text="لوحة التحكم" 
                       Style="{StaticResource MaterialDesignHeadline3TextBlock}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>

            <!-- Statistics Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Today Sales Total -->
                <materialDesign:Card Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="CurrencyUsd" 
                                               Width="48" Height="48" 
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Name="totalSales" Text="{Binding TodaySalesTotal, StringFormat='{}{0:C}'}" 
                                   Style="{StaticResource DashboardTextStyle}"/>
                        <TextBlock Text="إجمالي مبيعات اليوم" Style="{StaticResource DashboardLabelStyle}"/>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Today Sales Count -->
                <materialDesign:Card Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Receipt" 
                                               Width="48" Height="48" 
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Name="totalInvoices" Text="{Binding TodaySalesCount}" 
                                   Style="{StaticResource DashboardTextStyle}"/>
                        <TextBlock Text="عدد الفواتير اليوم" Style="{StaticResource DashboardLabelStyle}"/>
                    </StackPanel>
                </materialDesign:Card>

            </Grid>

            <!-- Charts Section -->
            <Grid Margin="0,30,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="المنتجات الأكثر مبيعًا" 
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Top Selling Products Table -->
                <!-- Table with Borders -->
                <materialDesign:Card Grid.Row="1" 
                    Style="{StaticResource DashboardCardStyle}"
                    Margin="0,10,0,-69">

                    <StackPanel>

                        <TextBlock Text="المنتجات الأكثر مبيعًا" 
                   Style="{StaticResource MaterialDesignHeadline4TextBlock}"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <!-- Product Rows -->
                            <!-- Repeat for Products 3, 4, 5 with alternating backgrounds -->
                            <!-- Header Row with Background -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4,4,0,0" RenderTransformOrigin="0.502,-0.482">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الترتيب" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                    <TextBlock Grid.Column="1" Text="اسم المنتج" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                    <TextBlock Grid.Column="2" Text="الكمية المباعة" FontWeight="Bold" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                </Grid>
                            </Border>

                            <!-- Product 1 -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="1" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product1Name}" Margin="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product1QuantitySold}" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Product 2 -->
                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="#F8F9FA" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="2" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product2Name}" Margin="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product2QuantitySold}" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Product 3 -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="3" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product3Name}" Margin="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product3QuantitySold}" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Product 4 -->
                            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Background="#F8F9FA" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="4" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product4Name}" Margin="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product4QuantitySold}" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>

                            <!-- Product 5 -->
                            <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" CornerRadius="0,0,4,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="5" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Product5Name}" Margin="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Product5QuantitySold}" Margin="10" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidBrush}" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Refresh Button -->
            <Button Click="RefreshButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    materialDesign:ButtonAssist.CornerRadius="20" RenderTransformOrigin="0.475,1.247">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" 
                                               Width="20" Height="20" 
                                               Margin="0,0,10,0"/>
                        <TextBlock Text="تحديث البيانات" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
