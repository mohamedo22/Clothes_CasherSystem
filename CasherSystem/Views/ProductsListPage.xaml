<Page x:Class="CasherSystem.Views.ProductsListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="المنتجات" FlowDirection="RightToLeft" Background="{DynamicResource MaterialDesignPaper}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="قائمة المنتجات" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="إدارة وإستعراض المنتجات" FontSize="14" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBox x:Name="searchBox"
                         Width="500"
                         materialDesign:HintAssist.Hint="بحث بالاسم أو اللون أو المقاس"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextChanged="SearchBox_TextChanged"
                         Margin="0,0,8,0"/>
                <Button Content="إضافة منتج"
                        Width="100"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="AddProductButton_Click"/>
            </DockPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="المقاس" Binding="{Binding Size}" Width="100"/>
                    <DataGridTextColumn Header="اللون" Binding="{Binding Color}" Width="120"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SellPrice, StringFormat=C}" Width="140"/>
                    <DataGridTemplateColumn Header="إجراءات" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="تعديل" Style="{StaticResource MaterialDesignFlatButton}" Click="EditProductButton_Click" Tag="{Binding}" Margin="0,0,6,0"/>
                                    <Button Content="حذف" Style="{StaticResource MaterialDesignFlatButton}" Click="DeleteProductButton_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding Products.Count, StringFormat=إجمالي: {0}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>

