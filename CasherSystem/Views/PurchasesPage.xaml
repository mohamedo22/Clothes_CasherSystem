<Page x:Class="CasherSystem.Views.PurchasesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Purchases"
      Background="{DynamicResource MaterialDesignPaper}">
    
    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Purchases" 
                      FontSize="32" 
                      FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Add new inventory and update product stock" 
                      FontSize="16" 
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Product Selection -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Product Selection" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Margin="0,0,0,20"/>

                    <!-- New Product Creation -->
                    <Expander Header="Create New Product" Margin="0,0,0,20">
                        <StackPanel Margin="0,10,0,0">
                            <TextBox materialDesign:HintAssist.Hint="Product Name"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,10"
                                    Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox materialDesign:HintAssist.Hint="Barcode"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,10"
                                    Text="{Binding NewProductBarcode, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Size"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding NewProductSize, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,5,0"/>

                                <TextBox Grid.Column="1"
                                        materialDesign:HintAssist.Hint="Color"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding NewProductColor, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="5,0,0,0"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                        materialDesign:HintAssist.Hint="Cost Price"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,5,0"/>

                                <TextBox Grid.Column="1"
                                        materialDesign:HintAssist.Hint="Sell Price"
                                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                        Text="{Binding NewProductSellPrice, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="5,0,0,0"/>
                            </Grid>

                            <Button Content="Create Product"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="CreateNewProductButton_Click"
                                   HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Expander>

                    <!-- Product List -->
                    <DataGrid ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             Margin="0,0,0,20"
                             MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80"/>
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="80"/>
                            <DataGridTextColumn Header="Current Stock" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Current Cost" Binding="{Binding CostPrice, StringFormat=C}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Quantity and Cost Price -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                materialDesign:HintAssist.Hint="Quantity"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,10,0"/>

                        <TextBox Grid.Column="1"
                                materialDesign:HintAssist.Hint="Cost Price"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,10,0"/>

                        <Button Grid.Column="2"
                               Content="Add to Purchase"
                               Style="{StaticResource ActionButtonStyle}"
                               Click="AddToPurchaseButton_Click"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Right Panel - Purchase Items -->
            <materialDesign:Card Grid.Column="1" Margin="10,0,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Purchase Items" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Margin="0,0,0,20"/>

                    <!-- Purchase Items -->
                    <DataGrid ItemsSource="{Binding PurchaseItems}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="Horizontal"
                             HeadersVisibility="Column"
                             Margin="0,0,0,20"
                             MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTextColumn Header="Cost" Binding="{Binding CostPrice, StringFormat=C}" Width="80"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="80"/>
                            <DataGridTemplateColumn Header="Action" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove"
                                               Style="{StaticResource MaterialDesignFlatButton}"
                                               Command="{Binding DataContext.RemoveFromPurchaseCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                               CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="Total:" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Total, StringFormat=C}" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel>
                        <Button Content="Save Purchase"
                               Style="{StaticResource ActionButtonStyle}"
                               Click="SavePurchaseButton_Click"
                               Margin="0,0,0,10"/>

                        <Button Content="Clear Purchase"
                               Style="{StaticResource ActionButtonStyle}"
                               Click="ClearPurchaseButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>
