<Page x:Class="CasherSystem.Views.PurchaseFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="500"
      Title="نموذج الشراء"
      FlowDirection="RightToLeft"
      Background="{DynamicResource MaterialDesignPaper}">

    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="نموذج الشراء" 
                      FontSize="32" 
                      FontWeight="Bold"
                      Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="{Binding FormSubtitle}" 
                      FontSize="16" 
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="1" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" 
                              FontSize="20" 
                              FontWeight="Bold"
                              Margin="0,0,0,20"/>

                    <!-- Purchase Form -->
                    <StackPanel>
                        <!-- Purchase Information -->
                        <TextBlock Text="معلومات الشراء" 
                                  FontWeight="Bold"
                                  FontSize="14"
                                  Margin="0,0,0,15"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <!-- Date -->
                        <DatePicker materialDesign:HintAssist.Hint="تاريخ الشراء *"
                                   Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                   SelectedDate="{Binding CurrentPurchase.Date}"
                                   Margin="0,0,0,15"/>

                        <!-- Supplier Information -->
                        <TextBlock Text="بيانات المورد" 
                                  FontWeight="Bold"
                                  FontSize="14"
                                  Margin="0,0,0,10"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <TextBox materialDesign:HintAssist.Hint="اسم المورد *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding CurrentPurchase.Supplier.Name, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10"/>

                        <TextBox materialDesign:HintAssist.Hint="رقم هاتف المورد *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding CurrentPurchase.Supplier.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,20"/>

                        <!-- Amounts Section -->
                        <TextBlock Text="المبالغ المالية" 
                                  FontWeight="Bold"
                                  FontSize="14"
                                  Margin="0,0,0,10"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                        <TextBox materialDesign:HintAssist.Hint="إجمالي الفاتورة *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding Total, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10"/>

                        <TextBox materialDesign:HintAssist.Hint="المبلغ المدفوع *"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,10"/>

                        <TextBox materialDesign:HintAssist.Hint="المبلغ المتبقي"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding RemainingAmount, StringFormat=C}"
                                IsReadOnly="True"
                                Foreground="Gray"
                                Background="#F5F5F5"
                                Margin="0,0,0,20"/>

                        <!-- Validation Messages -->
                        <Border Background="#FFF0F0" 
                                BorderBrush="#FFCCCC" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,20"
                                Visibility="{Binding HasValidationErrors, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="يرجى تصحيح الأخطاء التالية:" 
                                          FontWeight="Bold" 
                                          Foreground="#CC0000"
                                          Margin="0,0,0,5"/>
                                <ItemsControl ItemsSource="{Binding ValidationErrors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                      Foreground="#CC0000" 
                                                      Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Form Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="حفظ"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="SavePurchaseButton_Click"
                                   Margin="0,0,10,0"
                                   Background="{DynamicResource PrimaryHueMidBrush}"
                                   IsEnabled="{Binding CanSave}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,5,0" Width="16" Height="16"/>
                                            <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>


                            <Button Content="تفريغ الحقول"
                                   Style="{StaticResource ActionButtonStyle}"
                                   Click="ClearFormButton_Click"
                                   Margin="10,0,0,0"
                                   Background="{DynamicResource SecondaryHueMidBrush}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Broom" Margin="0,0,5,0" Width="16" Height="16"/>
                                            <TextBlock Text="تفريغ" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesignBody}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding FormMode}" FontWeight="Bold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>