<Page x:Class="CasherSystem.Views.SaleDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      FlowDirection="RightToLeft">

    <Page.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignSubtitle1TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,5,10,5"/>
        </Style>

        <Style x:Key="InfoValueStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>

        <!-- DataGrid Styles -->
        <Style x:Key="CenterAlignTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="تفاصيل الفاتورة" Style="{StaticResource HeaderTextStyle}"/>

            <!-- Sale Information Card -->
            <materialDesign:Card Grid.Row="1" 
                                Margin="0,0,0,20" 
                                Padding="20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="رقم الفاتورة:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Sale.Id}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="التاريخ:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Sale.Date, StringFormat='yyyy/MM/dd HH:mm'}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="المجموع:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sale.Total, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="الخصم:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Sale.Discount, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="الصافي:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Sale.NetTotal, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="نوع الدفع:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Sale.PaymentType}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="المدفوع:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Sale.paidAmount, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="المتبقي:" Style="{StaticResource InfoLabelStyle}"/>
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Sale.remainingAmount, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>
                </Grid>
            </materialDesign:Card>

            <!-- User Information Card -->
            <materialDesign:Card Grid.Row="2" 
                                Margin="0,0,0,20" 
                                Padding="20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="معلومات المستخدم" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="اسم المستخدم:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Sale.User.Username}" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="رقم الهاتف:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Sale.User.PhoneNumber}" Style="{StaticResource InfoValueStyle}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Products Information Card -->
            <materialDesign:Card Grid.Row="3" 
                    Margin="0,0,0,20" 
                    Padding="0"
                    materialDesign:ElevationAssist.Elevation="Dp4"
                    Background="{DynamicResource MaterialDesignPaper}">

                <StackPanel>
                    <!-- Header Section -->
                    <Border Background="{DynamicResource PrimaryHueMidBrush}" 
                            Padding="20,16" 
                            CornerRadius="4,4,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariant" 
                                        Foreground="White"
                                        Width="24" 
                                        Height="24" 
                                        Margin="0,0,12,0"/>
                            <TextBlock Text="المنتجات المباعة" 
                          Foreground="White"
                          FontWeight="SemiBold"
                          FontSize="18"
                          VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid Section -->
                    <DataGrid x:Name="ProductsDataGrid"
                 ItemsSource="{Binding Sale.products}"
                 AutoGenerateColumns="False"
                 CanUserAddRows="False"
                 CanUserDeleteRows="False"
                 CanUserResizeColumns="True"
                 CanUserResizeRows="False"
                 CanUserSortColumns="True"
                 IsReadOnly="True"
                 GridLinesVisibility="None"
                 HeadersVisibility="Column"
                 BorderThickness="0"
                 Background="Transparent"
                 RowBackground="Transparent"
                 AlternatingRowBackground="{DynamicResource MaterialDesignGrid}"
                 ColumnHeaderHeight="48"
                 RowHeight="42"
                 FontSize="14"
                 MinWidth="1000"
                 HorizontalScrollBarVisibility="Auto"
                 materialDesign:DataGridAssist.CellPadding="12,8"
                 materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                 ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                 RowStyle="{StaticResource DataGridRowStyle}"
                 CellStyle="{StaticResource DataGridCellStyle}">

                        <DataGrid.Columns>
                            <!-- Product Name -->
                            <DataGridTemplateColumn Header="اسم المنتج" Width="2*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CubeOutline" 
                                                        Width="16" 
                                                        Height="16" 
                                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                        Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Product.Name}" 
                                          VerticalAlignment="Center"
                                          TextWrapping="NoWrap"
                                          TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Barcode -->
                            <DataGridTextColumn Header="الباركود" 
                                   Binding="{Binding Product.Barcode}" 
                                   Width="1.5*" 
                                   MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Size -->
                            <DataGridTextColumn Header="المقاس" 
                                   Binding="{Binding Product.Size}" 
                                   Width="0.8*" 
                                   MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Color -->
                            <DataGridTextColumn Header="اللون" 
                                   Binding="{Binding Product.Color}" 
                                   Width="1*" 
                                   MinWidth="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Quantity Sold -->
                            <DataGridTemplateColumn Header="الكمية المباعة" Width="1.2*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Numeric" 
                                                        Width="14" 
                                                        Height="14" 
                                                        Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                        Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding saledQuantity}" 
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Unit Price -->
                            <DataGridTextColumn Header="سعر الوحدة" 
                                   Binding="{Binding Product.SellPrice, StringFormat='{}{0:N2} جنيه'}" 
                                   Width="1.2*" 
                                   MinWidth="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightAlignTextStyle}"/>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Total Price -->
                            <DataGridTemplateColumn Header="المجموع" Width="1.2*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource PrimaryHueLightBrush}" 
                                    CornerRadius="4" 
                                    Padding="8,4"
                                    HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Total, StringFormat='{}{0:N2} جنيه'}" 
                                          Foreground="{DynamicResource PrimaryHueLightForegroundBrush}"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Footer Summary -->
                    <Border Background="{DynamicResource MaterialDesignGrid}" 
                            Padding="20,12" 
                            CornerRadius="0,0,4,4"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Sale.products.Count, StringFormat='إجمالي العناصر: {0}'}" 
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      VerticalAlignment="Center"
                                      FontSize="13"/>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="المجموع الكلي: " 
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,8,0"
                                          FontSize="13"/>
                                <TextBlock Text="{Binding Sale.TotalAmount, StringFormat='{}{0:N2} جنيه'}" 
                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                          FontWeight="Bold"
                                          FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!-- Summary Card -->
            <materialDesign:Card Grid.Row="4" 
                                Padding="20"
                                materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="ملخص الفاتورة" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="إجمالي المنتجات:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalProductsCount}" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="إجمالي الكمية المباعة:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalQuantitySold}" Style="{StaticResource InfoValueStyle}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="إجمالي المبلغ:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sale.NetTotal, StringFormat='{}{0:N2} جنيه'}" Style="{StaticResource InfoValueStyle}"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </ScrollViewer>
</Page>