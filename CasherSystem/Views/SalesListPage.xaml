<Page x:Class="CasherSystem.Views.SalesListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FlowDirection="RightToLeft">

    <Page.Resources>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        
        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style x:Key="ActiveFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource FilterButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
        </Style>
        
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style x:Key="ViewDetailsButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SecondaryHueMidBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="قائمة المبيعات" 
                   Style="{StaticResource HeaderTextStyle}"/>

        <!-- Filter Section -->
        <materialDesign:Card Grid.Row="1" 
                            Margin="0,0,0,20" 
                            Padding="20"
                            materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="فلترة المبيعات" 
                          Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                          Margin="0,0,0,15"/>
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AllSalesButton"
                           Content="جميع المبيعات"
                           Style="{StaticResource ActiveFilterButtonStyle}"
                           Click="AllSalesButton_Click"/>
                    
                    <Button x:Name="CashSalesButton"
                           Content="المبيعات النقدية"
                           Style="{StaticResource FilterButtonStyle}"
                           Click="CashSalesButton_Click"/>
                    
                    <Button x:Name="DebtSalesButton"
                           Content="المبيعات الآجلة"
                           Style="{StaticResource FilterButtonStyle}"
                           Click="DebtSalesButton_Click"/>
                    
                    <Button x:Name="RefreshButton"
                           Style="{StaticResource FilterButtonStyle}"
                           Click="RefreshButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="تحديث"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- Sales DataGrid -->
        <materialDesign:Card Grid.Row="2" 
                            materialDesign:ElevationAssist.Elevation="Dp2">
            <DataGrid x:Name="SalesDataGrid"
                     ItemsSource="{Binding SalesList}"
                     SelectedItem="{Binding SelectedSale}"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserResizeColumns="True"
                     CanUserSortColumns="True"
                     GridLinesVisibility="Horizontal"
                     HeadersVisibility="Column"
                     materialDesign:DataGridAssist.CellPadding="13,8,8,8"
                     materialDesign:DataGridAssist.ColumnHeaderPadding="8">
                
                <DataGrid.Columns>
                    <!-- Sale ID -->
                    <DataGridTextColumn Header="رقم الفاتورة" 
                                       Binding="{Binding Id}" 
                                       Width="100"/>
                    
                    <!-- Date -->
                    <DataGridTextColumn Header="التاريخ" 
                                       Binding="{Binding Date, StringFormat='yyyy/MM/dd HH:mm'}" 
                                       Width="150"/>
                    
                    <!-- Total -->
                    <DataGridTextColumn Header="المجموع" 
                                       Binding="{Binding Total, StringFormat='{}{0:N2} جنيه'}" 
                                       Width="120"/>
                    
                    <!-- Discount -->
                    <DataGridTextColumn Header="الخصم" 
                                       Binding="{Binding Discount, StringFormat='{}{0:N2} جنيه'}" 
                                       Width="100"/>
                    
                    <!-- Net Total -->
                    <DataGridTextColumn Header="الصافي" 
                                       Binding="{Binding NetTotal, StringFormat='{}{0:N2} جنيه'}" 
                                       Width="120"/>
                    
                    <!-- Payment Type -->
                    <DataGridTextColumn Header="نوع الدفع" 
                                       Binding="{Binding PaymentType}" 
                                       Width="100"/>
                    
                    <!-- Paid Amount -->
                    <DataGridTextColumn Header="المدفوع" 
                                       Binding="{Binding paidAmount, StringFormat='{}{0:N2} جنيه'}" 
                                       Width="100"/>
                    
                    <!-- Remaining Amount -->
                    <DataGridTextColumn Header="المتبقي" 
                                       Binding="{Binding remainingAmount, StringFormat='{}{0:N2} جنيه'}" 
                                       Width="100"/>
                    
                    <!-- Secret Code -->
                    <DataGridTextColumn Header="الكود السري" 
                                       Binding="{Binding SecretCode}" 
                                       Width="120"/>
                    
                    <!-- User -->
                    <DataGridTextColumn Header="المستخدم" 
                                       Binding="{Binding User.Username}" 
                                       Width="120"/>
                    
                    <!-- Actions -->
                    <DataGridTemplateColumn Header="الإجراءات" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="عرض باقي التفاصيل"
                                           Style="{StaticResource ViewDetailsButtonStyle}"
                                           Tag="{Binding}"
                                           Click="ViewDetailsButton_Click"/>
                                    
                                    <Button Content="حذف"
                                           Style="{StaticResource DeleteButtonStyle}"
                                           Tag="{Binding}"
                                           Click="DeleteButton_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</Page>
